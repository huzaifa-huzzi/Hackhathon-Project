modules = ["python-3.11"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "SikkaCheck API"

[[workflows.workflow]]
name = "SikkaCheck API"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd lib/backend && venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 5000 --reload"
waitForPort = 5000
